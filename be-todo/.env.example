PORT=3040
DATABASE_URL=postgresql://user:password@localhost:5432/todo
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
# Required: generate with `openssl rand -base64 48` (min 32 chars)
JWT_SECRET=
JWT_TTL=7d

# Email: "log" prints verification/reset codes in the server log (dev); "smtp" sends them.
MAIL_TRANSPORT=log
# e.g. smtps://you%40gmail.com:app-password@smtp.gmail.com:465 (needed when MAIL_TRANSPORT=smtp)
SMTP_URL=
MAIL_FROM="TushDo <no-reply@localhost>"
